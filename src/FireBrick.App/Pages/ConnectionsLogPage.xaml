<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FireBrick.App.Pages.ConnectionsLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FireBrick.Core.Models">

    <Grid RowSpacing="12" Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Connections Log" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="NoWrap" />
                <TextBlock x:Name="SubtitleText" Text="Real-time WFP audit log and active TCP/UDP connections with reverse DNS." FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="AuditModeBtn" Content="WFP Audit Log" IsChecked="True" Click="ModeToggle_Click" />
                <ToggleButton x:Name="LiveModeBtn" Content="Live TCP/UDP" IsChecked="False" Click="ModeToggle_Click" />
                <Button Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh connections">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="LogInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <!-- Filter Bar -->
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Filter by app, remote IP, hostname, port, or protocol..." QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
            <CheckBox x:Name="BlockedOnlyCheck" Grid.Column="1" Content="Blocked Only" VerticalAlignment="Center" Checked="FilterOption_Changed" Unchecked="FilterOption_Changed" />
        </Grid>

        <!-- WFP Audit Log View -->
        <ListView x:Name="AuditListView" Grid.Row="3" SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ConnectionEventDto">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind LocalTimeDisplay}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                            <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{StaticResource FireBrickMutedBadgeBg}">
                                <TextBlock Text="{x:Bind Action}" FontSize="12" FontWeight="SemiBold" />
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ApplicationName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ApplicationPath}" />
                                <TextBlock Text="{x:Bind Publisher}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{x:Bind Protocol}" VerticalAlignment="Center" FontSize="12" />
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind RemoteEndpoint}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind GeoLocation}" FontSize="11" Foreground="{StaticResource FireBrickAccentBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="5" Text="{x:Bind RemoteHostName}" VerticalAlignment="Center" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Allow" Padding="8,4" FontSize="12" Tag="{x:Bind ApplicationPath}" Click="QuickAllow_Click" />
                                <Button Content="15m" Padding="8,4" FontSize="12" Tag="{x:Bind ApplicationPath}" Click="QuickTempAllow_Click" ToolTipService.ToolTip="Allow temporarily for 15 minutes" />
                                <Button Content="Block" Padding="8,4" FontSize="12" Tag="{x:Bind ApplicationPath}" Click="QuickBlock_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Live Active Connections View -->
        <ListView x:Name="LiveListView" Grid.Row="3" SelectionMode="Single" Visibility="Collapsed">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ActiveConnectionDto">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Protocol}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ProcessPath}" />
                                <TextBlock Text="{x:Bind ProcessPath}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind State}" VerticalAlignment="Center" FontSize="12" Opacity="0.8" />
                            <TextBlock Grid.Column="3" Text="{x:Bind LocalEndpoint}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind RemoteEndpoint}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind GeoLocation}" FontSize="11" Foreground="{StaticResource FireBrickAccentBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="5" Text="{x:Bind RemoteHostName}" VerticalAlignment="Center" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Allow" Padding="7,4" FontSize="11" Tag="{x:Bind ProcessPath}" Click="QuickAllow_Click" />
                                <Button Content="Block" Padding="7,4" FontSize="11" Tag="{x:Bind ProcessPath}" Click="QuickBlock_Click" />
                                <Button Content="Kill" Padding="7,4" FontSize="11" Tag="{x:Bind ProcessPath}" Click="QuickKill_Click" ToolTipService.ToolTip="Terminate active TCP sockets for this app" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
