<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FireBrick.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FireBrick — Windows Firewall Control">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,160,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="&#xEA18;" FontSize="18" Foreground="{StaticResource FireBrickAccentBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="FireBrick" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="Windows Firewall Control" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionBadgeText" Text="v1.0.0" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
            </StackPanel>

            <Border x:Name="StatusPill" Grid.Column="3" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Background="{StaticResource FireBrickMutedBadgeBg}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource FireBrickAllowBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusPillText" Text="Initializing..." FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main NavigationView -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="LeftCompact"
            IsPaneOpen="False"
            OpenPaneLength="220"
            PaneOpened="NavView_PaneStateChanged"
            PaneClosed="NavView_PaneStateChanged"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Applications" Tag="apps">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Firewall Rules" Tag="rules">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Connections Log" Tag="connections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Presets &amp; Temp Rules" Tag="presets">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Protection &amp; Lists" Tag="protection">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
