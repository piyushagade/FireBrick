<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FireBrick.App.Pages.ProtectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FireBrick.Core.Models">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" MaxWidth="1120" Padding="24,16,28,72">
                <StackPanel Spacing="4">
                    <TextBlock Text="Protection, Auto-Rules &amp; Blocklists" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Automated allow/block policies, Rule Lock tamper protection, auto-switching Wi-Fi profiles, and blocklist subscriptions." Opacity="0.7" />
                </StackPanel>

            <!-- 0. Auto-Allow & Auto-Block Rules -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Auto-Allow &amp; Auto-Block Rules" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Automatically handle blocked connections by app name/path, trusted publisher, IP/CIDR, or domain/host — silently or with a countdown. Evaluated top-to-bottom (first match wins)." FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ Add Auto-Rule" Style="{ThemeResource AccentButtonStyle}" Click="AddAutoRule_Click" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>

                    <TextBlock x:Name="EmptyAutoRulesText" Text="No auto-rules configured yet. Add a rule here or click the lightning icon on any connection alert." FontSize="12" Opacity="0.65" />

                    <ItemsControl x:Name="AutoRulesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AutoRuleDto">
                                <Border Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Background="{StaticResource FireBrickMutedBadgeBg}">
                                            <TextBlock Text="{x:Bind ActionDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FireBrickAccentBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind SummaryDisplay}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <ToggleSwitch IsOn="{x:Bind Enabled}" Tag="{x:Bind Id}" MinWidth="0" OnContent="" OffContent="" Toggled="AutoRuleEnabled_Toggled" Margin="0,0,4,0" />
                                            <Button Padding="6,5" Tag="{x:Bind Id}" Click="MoveAutoRuleUp_Click" ToolTipService.ToolTip="Move higher priority">
                                                <FontIcon Glyph="&#xE70E;" FontSize="11" />
                                            </Button>
                                            <Button Padding="6,5" Tag="{x:Bind Id}" Click="MoveAutoRuleDown_Click" ToolTipService.ToolTip="Move lower priority">
                                                <FontIcon Glyph="&#xE70D;" FontSize="11" />
                                            </Button>
                                            <Button Padding="6,5" Tag="{x:Bind Id}" Click="EditAutoRule_Click" ToolTipService.ToolTip="Edit auto-rule">
                                                <FontIcon Glyph="&#xE70F;" FontSize="11" />
                                            </Button>
                                            <Button Padding="6,5" Tag="{x:Bind Id}" Click="DeleteAutoRule_Click" ToolTipService.ToolTip="Delete auto-rule">
                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#EF4444" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 1. Rule Lock & Tamper Protection -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Rule Lock &amp; Tamper Protection" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Monitors Windows Defender Firewall for unauthorized third-party rule injections and automatically reverts them." FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="RuleLockToggle" Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="On" OffContent="Off" Toggled="RuleLockToggle_Toggled" />
                    </Grid>

                    <TextBlock x:Name="RuleLockEmptyText" Text="No unauthorized rule injections detected." FontSize="12" Opacity="0.65" />

                    <ItemsControl x:Name="RuleLockAlertsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RuleLockAlertDto">
                                <Border Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind TimeDisplay}" FontSize="12" Opacity="0.75" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind RuleName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ChangeType}" FontSize="12" Foreground="{StaticResource FireBrickWarnBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 2. Auto-Switching Network / Wi-Fi SSID Profiles -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Auto-Switching Network Profiles" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="CurrentNetworkText" Text="Current Network: Detecting..." FontSize="12" Opacity="0.75" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="+ Add Network Rule" Click="AddNetworkRule_Click" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="AutoSwitchToggle" MinWidth="0" OnContent="On" OffContent="Off" Toggled="AutoSwitchToggle_Toggled" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="EmptyNetworkRulesText" Text="No network rules configured yet. Add your Home Wi-Fi or untrusted Public Wi-Fi SSIDs." FontSize="12" Opacity="0.65" />

                    <ItemsControl x:Name="NetworkRulesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:NetworkProfileRuleDto">
                                <Border Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind NetworkName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProfileDisplay}" Foreground="{StaticResource FireBrickAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Remove" Padding="8,4" FontSize="12" Tag="{x:Bind Id}" Click="DeleteNetworkRule_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Domain & IP Blocklist Subscriptions -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Domain &amp; IP Blocklist Subscriptions" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Block telemetry domains or community IP/CIDR threat lists as managed Windows Firewall rules." FontSize="12" Opacity="0.75" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ Add Custom Blocklist" Style="{ThemeResource AccentButtonStyle}" Click="AddBlocklist_Click" />
                    </Grid>

                    <ItemsControl x:Name="BlocklistsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:BlocklistSubscriptionDto">
                                <Border Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind StatusDisplay}" FontSize="11" Foreground="{StaticResource FireBrickAccentBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Sync Now" Padding="10,5" FontSize="12" Tag="{x:Bind}" Click="SyncBlocklist_Click" />
                                            <Button Content="Remove Rules" Padding="10,5" FontSize="12" Tag="{x:Bind}" Click="RemoveBlocklist_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>

        <InfoBar
            x:Name="ProtectionInfoBar"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
            MaxWidth="1120"
            Margin="24,0,28,16"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            IsOpen="False"
            IsClosable="True" />
    </Grid>
</Page>
