<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FireBrick.App.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FireBrick.Core.Models">

    <Grid RowSpacing="12" Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + Compact Primary Toolbar -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Firewall Rules" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="NoWrap" />
                <TextBlock x:Name="RuleCountSubtitle" Text="Loading rules..." FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{ThemeResource AccentButtonStyle}" Click="NewRuleButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="New Rule" />
                    </StackPanel>
                </Button>

                <DropDownButton Content="Tools">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Find Duplicate Rules" Click="FindDuplicatesButton_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Clean Invalid Rules" Click="CleanupInvalidButton_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Export Rules to JSON" Click="ExportJsonButton_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Import Rules from JSON" Click="ImportJsonButton_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh rules">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- InfoBar -->
        <InfoBar x:Name="RulesInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <!-- Search & Filters -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="136" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="156" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Search by rule name, executable, port, IP, or group..."
                QueryIcon="Find"
                TextChanged="FilterChanged" />

            <ComboBox x:Name="DirectionFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="All Directions" Tag="All" />
                <ComboBoxItem Content="Outbound" Tag="Outbound" />
                <ComboBoxItem Content="Inbound" Tag="Inbound" />
            </ComboBox>

            <ComboBox x:Name="ActionFilter" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="All Actions" Tag="All" />
                <ComboBoxItem Content="Allow" Tag="Allow" />
                <ComboBoxItem Content="Block" Tag="Block" />
            </ComboBox>

            <ComboBox x:Name="StateFilter" Grid.Column="3" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="All States" Tag="All" />
                <ComboBoxItem Content="Enabled Only" Tag="Enabled" />
                <ComboBoxItem Content="Disabled Only" Tag="Disabled" />
                <ComboBoxItem Content="Invalid Paths" Tag="Invalid" />
                <ComboBoxItem Content="Temporary Rules" Tag="Temporary" />
                <ComboBoxItem Content="FireBrick Created" Tag="FireBrick" />
            </ComboBox>
        </Grid>

        <!-- Column Header (exact column widths matching row template) -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,12,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="2.6*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="On" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
                <TextBlock Grid.Column="1" Text="Rule Name / Group" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
                <TextBlock Grid.Column="2" Text="Application" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
                <TextBlock Grid.Column="3" Text="Direction" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
                <TextBlock Grid.Column="4" Text="Action" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
                <TextBlock Grid.Column="5" Text="Proto / Ports" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
                <TextBlock Grid.Column="6" Text="Actions" FontWeight="SemiBold" FontSize="12" Opacity="0.8" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Rules ListView -->
        <ListView
            x:Name="RulesListView"
            Grid.Row="4"
            SelectionMode="Single"
            IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,3,12,3" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FirewallRuleDto">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="2.6*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>

                            <ToggleSwitch
                                Grid.Column="0"
                                IsOn="{x:Bind Enabled, Mode=OneWay}"
                                OnContent=""
                                OffContent=""
                                MinWidth="44"
                                Tag="{x:Bind}"
                                Toggled="RuleToggle_Toggled"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind DisplayGrouping}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ApplicationDisplay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ExpandedApplicationPath}" />
                                <TextBlock Text="{x:Bind ProfilesDisplay}" FontSize="11" Opacity="0.65" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{x:Bind DirectionDisplay}" VerticalAlignment="Center" FontSize="12" Opacity="0.9" />

                            <Border Grid.Column="4" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{StaticResource FireBrickMutedBadgeBg}">
                                <TextBlock Text="{x:Bind ActionDisplay}" FontSize="12" FontWeight="SemiBold" />
                            </Border>

                            <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind ProtocolDisplay}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind RemotePorts}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Padding="7,6" Tag="{x:Bind}" Click="EditRuleButton_Click" ToolTipService.ToolTip="Edit rule">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                </Button>
                                <Button Padding="7,6" Tag="{x:Bind}" Click="DeleteRuleButton_Click" ToolTipService.ToolTip="Delete rule">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
