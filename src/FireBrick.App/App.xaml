<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FireBrick.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- FireBrick Semantic Brushes -->
            <SolidColorBrush x:Key="FireBrickAccentBrush" Color="#E05A2B" />
            <SolidColorBrush x:Key="FireBrickAllowBrush" Color="#10893E" />
            <SolidColorBrush x:Key="FireBrickBlockBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="FireBrickWarnBrush" Color="#D88A00" />
            <SolidColorBrush x:Key="FireBrickMutedBadgeBg" Color="#22808080" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
