<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FireBrick.App.Pages.DonatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left" Padding="24,16,28,24">
            <StackPanel Spacing="6">
                <TextBlock Text="Donate" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="FireBrick is free to use. If it helps keep your Windows network protected and under control, consider supporting Piyush Agade's development with a tip."
                    FontSize="13"
                    Opacity="0.75"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Cash App Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1E00D632" BorderBrush="#4500D632" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="$" FontSize="18" FontWeight="Bold" Foreground="#00D632" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Cash App" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="$piyushagade" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="CopyCashAppBtn" Tag="$piyushagade" Click="CopyHandle_Click" ToolTipService.ToolTip="Copy $piyushagade to clipboard">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="CopyCashAppIcon" Glyph="&#xE8C8;" FontSize="12" />
                                <TextBlock x:Name="CopyCashAppLabel" Text="Copy" />
                            </StackPanel>
                        </Button>
                        <Button Style="{ThemeResource AccentButtonStyle}" Tag="https://cash.app/$piyushagade" Click="OpenUrl_Click" ToolTipService.ToolTip="https://cash.app/$piyushagade">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                <TextBlock Text="Open Cash App" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Venmo Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1E008CFF" BorderBrush="#45008CFF" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="V" FontSize="18" FontWeight="Bold" Foreground="#38A8FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Venmo" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="@piyushagade" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="CopyVenmoBtn" Tag="@piyushagade" Click="CopyHandle_Click" ToolTipService.ToolTip="Copy @piyushagade to clipboard">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="CopyVenmoIcon" Glyph="&#xE8C8;" FontSize="12" />
                                <TextBlock x:Name="CopyVenmoLabel" Text="Copy" />
                            </StackPanel>
                        </Button>
                        <Button Style="{ThemeResource AccentButtonStyle}" Tag="https://venmo.com/u/piyushagade" Click="OpenUrl_Click" ToolTipService.ToolTip="https://venmo.com/u/piyushagade">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                <TextBlock Text="Open Venmo" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
