<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FireBrick.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FireBrick.Core.Models">

    <Grid RowSpacing="12" Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Applications" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="NoWrap" />
                <TextBlock x:Name="AppsSubtitle" Text="Per-application view combining firewall rules, live sockets, and blocked attempts." FontSize="12" Opacity="0.7" />
            </StackPanel>

            <Button Grid.Column="1" Click="RefreshButton_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Refresh applications">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <InfoBar x:Name="AppsInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <!-- Search & Filter -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Search by application name or path..."
                QueryIcon="Find"
                TextChanged="FilterChanged" />

            <ComboBox x:Name="AppFilterCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="All Applications" Tag="All" />
                <ComboBoxItem Content="Active Connections" Tag="Active" />
                <ComboBoxItem Content="Recently Blocked" Tag="Blocked" />
                <ComboBoxItem Content="Has Firewall Rules" Tag="Rules" />
            </ComboBox>
        </Grid>

        <!-- Grouped Apps List -->
        <ListView x:Name="AppsListView" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,3,12,3" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:AppGroupSummaryDto">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ApplicationName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ApplicationPath}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ApplicationPath}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="RULES" FontSize="10" FontWeight="SemiBold" Opacity="0.55" />
                                <TextBlock Text="{x:Bind RulesSummary}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="ACTIVITY" FontSize="10" FontWeight="SemiBold" Opacity="0.55" />
                                <TextBlock Text="{x:Bind ActivitySummary}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="Allow" Padding="10,5" FontSize="12" Tag="{x:Bind}" Click="AllowApp_Click" />
                                <Button Content="Block &amp; Kill" Padding="10,5" FontSize="12" Tag="{x:Bind}" Click="BlockAndKillApp_Click" ToolTipService.ToolTip="Create Block rule and terminate active TCP connections" />
                                <Button Padding="8,6" Tag="{x:Bind}" Click="InspectRules_Click" ToolTipService.ToolTip="View rules for this app">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
