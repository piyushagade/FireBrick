<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FireBrick.App.Windows.ConnectionAlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FireBrick Alert">

    <Grid x:Name="RootGrid" RowSpacing="10" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" PointerEntered="RootGrid_PointerEntered" PointerExited="RootGrid_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Draggable Title Bar (32px matches standard WinUI 3 caption button height) -->
        <Grid x:Name="DragHeader" Grid.Row="0" Padding="14,0,48,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="&#xEA18;" FontSize="16" Foreground="{StaticResource FireBrickAccentBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="HeaderTitleText" Grid.Column="1" Text="Blocked Outbound Connection" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

            <!-- Queue Pager (visible when >1 alerts queued) -->
            <StackPanel x:Name="QueuePagerPanel" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                <Button Padding="6,2" Click="PrevAlert_Click" ToolTipService.ToolTip="Previous alert">
                    <FontIcon Glyph="&#xE76B;" FontSize="10" />
                </Button>
                <TextBlock x:Name="QueueCounterText" Text="1 of 1" FontSize="12" Opacity="0.8" VerticalAlignment="Center" Margin="4,0" />
                <Button Padding="6,2" Click="NextAlert_Click" ToolTipService.ToolTip="Next alert">
                    <FontIcon Glyph="&#xE76C;" FontSize="10" />
                </Button>
            </StackPanel>

            <!-- Toggle Expanded / Condensed View -->
            <Button x:Name="ViewModeToggleButton" Grid.Column="3" Padding="6,3" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Click="ToggleViewMode_Click" ToolTipService.ToolTip="Switch to Condensed view">
                <FontIcon x:Name="ViewModeToggleIcon" Glyph="&#xE70E;" FontSize="11" />
            </Button>
        </Grid>

        <!-- Auto-Rule Countdown Banner (visible only when a Countdown Auto-Rule matches) -->
        <Border x:Name="CountdownBannerBorder" Grid.Row="1" Margin="14,0,14,0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Visibility="Collapsed">
            <StackPanel Spacing="5">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="CountdownIcon" Grid.Column="0" Glyph="&#xE916;" FontSize="13" Foreground="{StaticResource FireBrickAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountdownStatusText" Grid.Column="1" Text="Auto-Allowing in 5s..." FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Cancel" Padding="8,2" FontSize="11" Click="CancelCountdown_Click" />
                </Grid>
                <ProgressBar x:Name="CountdownProgressBar" Minimum="0" Maximum="100" Value="100" Height="3" />
            </StackPanel>
        </Border>

        <!-- Condensed Alert Content -->
        <Grid x:Name="CondensedContentPanel" Grid.Row="2" Padding="12,0,12,10" ColumnSpacing="10" Visibility="Collapsed" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                <Image x:Name="CondensedAppIconImage" Width="22" Height="22" Stretch="Uniform" Visibility="Collapsed" />
                <FontIcon x:Name="CondensedAppIconFallback" Glyph="&#xECAA;" FontSize="18" Opacity="0.7" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>

            <StackPanel x:Name="CondensedAppInfoPanel" Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <Grid ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CondensedAppNameText" Grid.Column="0" Text="application.exe" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="158" VerticalAlignment="Center" />
                    <FontIcon x:Name="CondensedTrustIcon" Grid.Column="1" Glyph="&#xE73E;" FontSize="11" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="CondensedPublisherText" Text="Unknown" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Icon-Only Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Padding="8,7" Style="{ThemeResource AccentButtonStyle}" Click="AllowPermanent_Click" ToolTipService.ToolTip="Allow permanently">
                    <FontIcon Glyph="&#xE73E;" FontSize="13" />
                </Button>
                <Button x:Name="CondensedTempAllowButton" Padding="8,7" Click="AllowTempCondensed_Click" ToolTipService.ToolTip="Allow temporarily (right-click for durations)">
                    <Button.ContextFlyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Allow for 5 minutes" Tag="5" Click="AllowTempMenu_Click" />
                            <MenuFlyoutItem Text="Allow for 15 minutes" Tag="15" Click="AllowTempMenu_Click" />
                            <MenuFlyoutItem Text="Allow for 1 hour" Tag="60" Click="AllowTempMenu_Click" />
                            <MenuFlyoutItem Text="Allow for 4 hours" Tag="240" Click="AllowTempMenu_Click" />
                        </MenuFlyout>
                    </Button.ContextFlyout>
                    <FontIcon Glyph="&#xE916;" FontSize="13" />
                </Button>
                <Button Padding="8,7" Click="BlockPermanent_Click" ToolTipService.ToolTip="Block permanently">
                    <FontIcon Glyph="&#xF140;" FontSize="13" Foreground="#EF4444" />
                </Button>
                <Button Padding="8,7" Click="IgnoreOnce_Click" ToolTipService.ToolTip="Ignore once (dismiss without creating a rule)">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Expanded Alert Content -->
        <StackPanel x:Name="ExpandedContentPanel" Grid.Row="2" Padding="16,0,16,0" Spacing="10">

            <!-- Application & Trust Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
                            <Image x:Name="AppIconImage" Width="20" Height="20" Stretch="Uniform" Visibility="Collapsed" />
                            <FontIcon x:Name="AppIconFallback" Glyph="&#xECAA;" FontSize="16" Opacity="0.7" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="AppNameText" Grid.Column="1" Text="application.exe" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border x:Name="TrustBadgeBorder" Grid.Column="2" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" Background="{StaticResource FireBrickMutedBadgeBg}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="TrustBadgeIcon" Glyph="&#xE73E;" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="TrustBadgeText" Text="Trusted" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="PublisherText" Text="Publisher: —" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" />

                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AppPathText" Text="C:\Path\To\App.exe" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Padding="6,4" Click="OpenLocation_Click" ToolTipService.ToolTip="Open file location in Explorer">
                            <FontIcon Glyph="&#xE838;" FontSize="11" />
                        </Button>
                        <Button x:Name="SearchWebButton" Grid.Column="2" Padding="6,4" Click="SearchWeb_Click" ToolTipService.ToolTip="Search online for this application (right-click to switch search engine)">
                            <Button.ContextFlyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Search with Google" Tag="Google" Click="SearchWebWithEngine_Click" />
                                    <MenuFlyoutItem Text="Search with Bing" Tag="Bing" Click="SearchWebWithEngine_Click" />
                                    <MenuFlyoutItem Text="Search with DuckDuckGo" Tag="DuckDuckGo" Click="SearchWebWithEngine_Click" />
                                </MenuFlyout>
                            </Button.ContextFlyout>
                            <FontIcon Glyph="&#xE721;" FontSize="11" />
                        </Button>
                        <Button Grid.Column="3" Padding="6,4" Click="CopyPath_Click" ToolTipService.ToolTip="Copy executable path">
                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Connection Details Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="REMOTE DESTINATION" FontSize="10" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="PROTOCOL / PID" FontSize="10" FontWeight="SemiBold" Opacity="0.6" HorizontalAlignment="Right" />

                    <TextBlock x:Name="RemoteEndpointText" Grid.Row="1" Grid.Column="0" Text="0.0.0.0:443" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ProtocolPidText" Grid.Row="1" Grid.Column="1" Text="TCP • PID 0" FontSize="12" Opacity="0.85" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock x:Name="RemoteHostText" Grid.Row="2" Grid.ColumnSpan="2" Text="" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Rule Scope Selector + Quick Auto-Rule Creator -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Rule Scope:" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                <ComboBox x:Name="ScopeCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="Any IP &amp; port" Tag="Any" />
                    <ComboBoxItem x:Name="ScopePortItem" Content="Port only" Tag="PortOnly" />
                    <ComboBoxItem x:Name="ScopeIpPortItem" Content="IP &amp; port" Tag="IpAndPort" />
                </ComboBox>
                <Button x:Name="AutoRuleQuickButton" Grid.Column="2" Padding="8,7" ToolTipService.ToolTip="Create Auto-Rule from this connection" Click="AutoRuleQuickButton_Click">
                    <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="{StaticResource FireBrickAccentBrush}" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- Action Footer -->
        <Border x:Name="ExpandedFooterBorder" Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Allow" Style="{ThemeResource AccentButtonStyle}" Click="AllowPermanent_Click" />

                <SplitButton x:Name="TempAllowButton" Grid.Column="1" Content="Allow (15m)" Click="AllowTempDefault_Click">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Allow for 5 minutes" Tag="5" Click="AllowTempMenu_Click" />
                            <MenuFlyoutItem Text="Allow for 15 minutes" Tag="15" Click="AllowTempMenu_Click" />
                            <MenuFlyoutItem Text="Allow for 1 hour" Tag="60" Click="AllowTempMenu_Click" />
                            <MenuFlyoutItem Text="Allow for 4 hours" Tag="240" Click="AllowTempMenu_Click" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>

                <Button Grid.Column="3" Content="Block" Click="BlockPermanent_Click" ToolTipService.ToolTip="Create an explicit Block rule so this app stops prompting" />
                <Button x:Name="IgnoreButton" Grid.Column="4" Content="Ignore" Click="IgnoreOnce_Click" ToolTipService.ToolTip="Dismiss this alert without creating a rule" />
            </Grid>
        </Border>
    </Grid>
</Window>
