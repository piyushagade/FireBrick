<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FireBrick.App.Pages.HostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FireBrick.Core.Models">

    <Grid>
        <Grid Padding="24,16,28,20" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Hosts File Editor" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="FilePathText" Text="C:\Windows\System32\drivers\etc\hosts" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{ThemeResource AccentButtonStyle}" Click="AddEntryButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Add Entry" />
                        </StackPanel>
                    </Button>
                    <Button Click="FlushDnsButton_Click" ToolTipService.ToolTip="Run ipconfig /flushdns so changes take effect immediately">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE753;" FontSize="12" />
                            <TextBlock Text="Flush DNS" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RestoreBackupBtn" Visibility="Collapsed" Click="RestoreBackupButton_Click" ToolTipService.ToolTip="Restore hosts file from FireBrick's automatic backup">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="12" />
                            <TextBlock Text="Restore Backup" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="RawModeToggle" Click="RawModeToggle_Click" ToolTipService.ToolTip="Switch between structured table view and raw text editor">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE943;" FontSize="12" />
                            <TextBlock Text="Raw File" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="12"
                            Padding="10,5"
                            MinWidth="0"
                            MinHeight="26"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            Click="RefreshButton_Click"
                            ToolTipService.ToolTip="Reload hosts file from disk"
                            AutomationProperties.Name="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search & Filter Bar (Table Mode) -->
            <Grid x:Name="FilterBar" Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Column="0"
                                PlaceholderText="Filter by IP address, hostname, or comment..."
                                QueryIcon="Find"
                                TextChanged="SearchBox_TextChanged" />

                <ComboBox x:Name="FilterCombo" Grid.Column="1" Width="190" SelectedIndex="0" SelectionChanged="FilterCombo_SelectionChanged">
                    <ComboBoxItem Content="All Entries" Tag="All" />
                    <ComboBoxItem Content="Enabled Only" Tag="Enabled" />
                    <ComboBoxItem Content="Disabled Only" Tag="Disabled" />
                    <ComboBoxItem Content="Blocked / Localhost" Tag="Sinkhole" />
                </ComboBox>

                <Border Grid.Column="2" CornerRadius="12" Padding="10,5" Background="{StaticResource FireBrickMutedBadgeBg}" VerticalAlignment="Center">
                    <TextBlock x:Name="EntryCountText" Text="0 entries" FontSize="12" Opacity="0.85" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Structured Table View -->
            <Border x:Name="TableViewContainer"
                    Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Column Header Band -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="7,7,0,0"
                            Padding="16,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ACTIVE" FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="1" Text="TYPE" FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="2" Text="IP ADDRESS" FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="3" Text="HOSTNAME(S)" FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="4" Text="COMMENT" FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="EmptyStateText"
                                       Text="No hosts entries match your filter. Click 'Add Entry' to map or block a domain."
                                       FontSize="12"
                                       Opacity="0.65"
                                       Margin="16,24"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed" />

                            <ItemsControl x:Name="HostsEntriesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HostsEntryDto">
                                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="76" />
                                                </Grid.ColumnDefinitions>

                                                <ToggleSwitch Grid.Column="0"
                                                              IsOn="{x:Bind Enabled}"
                                                              OnContent=""
                                                              OffContent=""
                                                              MinWidth="0"
                                                              VerticalAlignment="Center"
                                                              Tag="{x:Bind}"
                                                              Toggled="EntryToggle_Toggled" />

                                                <Border Grid.Column="1"
                                                        CornerRadius="6"
                                                        Padding="7,2"
                                                        Background="{StaticResource FireBrickMutedBadgeBg}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind TypeBadge}" FontSize="10" FontWeight="SemiBold" Opacity="0.85" />
                                                </Border>

                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind Address}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Address}" />

                                                <TextBlock Grid.Column="3"
                                                           Text="{x:Bind Hosts}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Hosts}" />

                                                <TextBlock Grid.Column="4"
                                                           Text="{x:Bind Comment}"
                                                           FontSize="12"
                                                           Opacity="0.65"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Comment}" />

                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Padding="7,5" Tag="{x:Bind}" Click="EditEntryButton_Click" ToolTipService.ToolTip="Edit entry">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                    </Button>
                                                    <Button Padding="7,5" Tag="{x:Bind}" Click="DeleteEntryButton_Click" ToolTipService.ToolTip="Delete entry">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource FireBrickBlockBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Raw Text Editor View -->
            <Border x:Name="RawViewContainer"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="7,7,0,0"
                            Padding="16,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE943;" FontSize="14" Opacity="0.85" VerticalAlignment="Center" />
                                <TextBlock Text="Raw Hosts File" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="(edits overwrite the entire file; an automatic backup is kept)" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Discard" Click="DiscardRawButton_Click" />
                                <Button Content="Save Raw File" Style="{ThemeResource AccentButtonStyle}" Click="SaveRawButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBox x:Name="RawEditorTextBox"
                             Grid.Row="1"
                             FontFamily="Consolas"
                             FontSize="12"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             BorderThickness="0"
                             Padding="14"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <!-- Floating Bottom-Right Toast -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="24,0,28,20"
                MaxWidth="460"
                CornerRadius="4"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
            <InfoBar x:Name="HostsToast"
                     IsOpen="False"
                     IsClosable="True"
                     Closed="HostsToast_Closed" />
        </Border>
    </Grid>
</Page>
